{
  "manifest_version": 3,
  "name": "JS Recon",
  "short_name": "JS Recon",
  "version": "1.1.0",
  "description": "Scans the JavaScript of pages you visit for endpoints, API keys, secrets, source maps, cloud assets and other recon data.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JS Recon",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "ui/options.html",
  "permissions": ["storage", "unlimitedStorage", "webRequest", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
